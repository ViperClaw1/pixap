# Copy to .env for local dev (Expo loads EXPO_PUBLIC_* at bundle time)

# PostHog product analytics — create a project at posthog.com (free tier: 1M events/month)
# EXPO_PUBLIC_POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.posthog.com  # or https://us.posthog.com

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# `1`: pregen `*_thumb/_hero/_gallery/_feed/_story.webp` via object/public first;
# `/render/image/` only when pregen is missing. EAS builds: set in EAS Environment (not eas.json).
EXPO_PUBLIC_SUPABASE_IMAGE_TRANSFORM=1

# Google Cloud → OAuth 2.0 client → Authorized redirect URIs (same project as EXPO_PUBLIC_SUPABASE_URL), e.g.:
# https://ylcyktbppowabnxuwdrr.supabase.co/auth/v1/callback
#
# Apple “Sign in with Apple” (Services ID, e.g. com.pixgo.pixgo.appleauth):
# • Return URL (Apple Developer → Services ID → Web): MUST be exactly:
#   https://ylcyktbppowabnxuwdrr.supabase.co/auth/v1/callback
# • That URL is Supabase’s server (GoTrue); the app never opens it directly.
#   After Apple → Supabase, the user is redirected to the in-app URL from
#   getOAuthRedirectUri() (e.g. pixapp://~oauth/callback); list that exact URL
#   under Supabase → Authentication → URL Configuration → Redirect URLs.

# HTTPS origin for email confirm / password reset (NOT the in-app OAuth return URL)
EXPO_PUBLIC_OAUTH_REDIRECT_BASE=https://pixapp.kz

# Optional: force native OAuth redirect (default = app scheme + /~oauth/callback from Expo Linking)
# EXPO_PUBLIC_OAUTH_MOBILE_REDIRECT_URI=pixapp://~oauth/callback

# Deep link scheme for Stripe return (must match app.config.ts `scheme`)
EXPO_PUBLIC_STRIPE_RETURN_SCHEME=pixapp

# Optional: EAS project ID for push (expo-notifications)
# EXPO_PUBLIC_EAS_PROJECT_ID=

# In-app subscriptions (must match App Store Connect / Google Play product IDs)
# EXPO_PUBLIC_PIXAI_MONTHLY_SUBSCRIPTION_SKU=pixai_premium_monthly
# EXPO_PUBLIC_PIXAI_ANNUAL_SUBSCRIPTION_SKU=pixai_premium_annual

# Admin dashboard: force mock analytics when RPC is not deployed locally
# EXPO_PUBLIC_ADMIN_ANALYTICS_USE_MOCK=true

# In-app maps + directions (Google Cloud: Directions API, Geocoding API, Places API, Maps Static API;
# native Maps SDK Android/iOS only needed for DirectionsModal / other MapView screens)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: separate key for Geocoding/Places REST (defaults to EXPO_PUBLIC_GOOGLE_MAPS_API_KEY)
# EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
#
# Production Android + API key restricted to "Android apps": Google requires SHA-1 on REST calls.
# Set to the same 40-char SHA-1 as in Google Cloud (with or without colons). EAS: set for the production profile.
# EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_CERT_SHA1=

# Lemon Squeezy checkout via reverse proxy (see supabase/proxy/api.pixapp.kz.nginx.conf.example).
# If unset, server-side callers use Supabase Edge Functions URL directly (fine for local dev).
# EXPO_PUBLIC_PIXAPP_API_URL=https://api.pixapp.kz

# Edge Function secrets (Supabase Dashboard → Edge Functions → Secrets, not in this file):
# IAP (iap-verify-purchase, iap-apple-notifications, iap-google-rtdn):
# APPLE_ISSUER_ID=, APPLE_KEY_ID=, APPLE_BUNDLE_ID=com.pixap.pixap, APPLE_PRIVATE_KEY= (PKCS8, \n escaped)
# Optional: APPLE_APP_STORE_SERVER_URL=https://api.storekit-sandbox.itunes.apple.com (sandbox-only testing)
# GOOGLE_PLAY_PACKAGE_NAME=com.pixap.pixap
# GOOGLE_SERVICE_ACCOUNT_EMAIL=...@....iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY= (PKCS8, \n escaped)
# Google Cloud: enable "Google Play Android Developer API".
# Play Console → Settings → API access: link service account, grant "Manage orders and subscriptions".
# SUPABASE_SERVICE_ROLE_KEY=
# EXPO_ACCESS_TOKEN= (Expo account token; optional, improves Expo Push API rate limits)
# TEST_PUSH_SECRET= (shared secret header for `send-test-push` smoke test)
# PUSH_CRON_SECRET= (optional; for pg_cron DB invoke — same value in vault as push_cron_secret)
#
# Push outbox delivery:
# 1. Deploy: supabase functions deploy consume-push-outbox
# 2. App calls consume-push-outbox on login/foreground (user JWT) — no Vault required for that path.
# 3. Background/cron (optional): vault secrets + migration 20260518000006_push_outbox_invoke_fix.sql
#    supabase secrets set PUSH_CRON_SECRET=<random>
#    select vault.create_secret('<random>', 'push_cron_secret', 'push_cron_secret');
#    -- or: select vault.create_secret('<SERVICE_ROLE_KEY>', 'service_role_key', 'service_role_key');
# 4. Production Android/iOS: Expo dashboard → Credentials (FCM + APNs)
# 5. Smoke test: send-test-push with ExponentPushToken[...]
