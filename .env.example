# Copy to .env for local dev (Expo loads EXPO_PUBLIC_* at bundle time)

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Cloud → OAuth 2.0 client → Authorized redirect URIs (same project as EXPO_PUBLIC_SUPABASE_URL), e.g.:
# https://ylcyktbppowabnxuwdrr.supabase.co/auth/v1/callback
#
# Apple “Sign in with Apple” (Services ID, e.g. com.pixgo.pixgo.appleauth):
# • Return URL (Apple Developer → Services ID → Web): MUST be exactly:
#   https://ylcyktbppowabnxuwdrr.supabase.co/auth/v1/callback
# • That URL is Supabase’s server (GoTrue); the app never opens it directly.
#   After Apple → Supabase, the user is redirected to the in-app URL from
#   getOAuthRedirectUri() (e.g. pixapp://~oauth/callback); list that exact URL
#   under Supabase → Authentication → URL Configuration → Redirect URLs.

# HTTPS origin for email confirm / password reset (NOT the in-app OAuth return URL)
EXPO_PUBLIC_OAUTH_REDIRECT_BASE=https://pixapp.kz

# Optional: force native OAuth redirect (default = app scheme + /~oauth/callback from Expo Linking)
# EXPO_PUBLIC_OAUTH_MOBILE_REDIRECT_URI=pixapp://~oauth/callback

# Deep link scheme for Stripe return (must match app.config.ts `scheme`)
EXPO_PUBLIC_STRIPE_RETURN_SCHEME=pixapp

# Optional: EAS project ID for push (expo-notifications)
# EXPO_PUBLIC_EAS_PROJECT_ID=

# In-app maps + directions (Google Cloud: Maps SDK Android/iOS, Directions API, Geocoding API, Places API)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: separate key for Geocoding/Places REST (defaults to EXPO_PUBLIC_GOOGLE_MAPS_API_KEY)
# EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
#
# Production Android + API key restricted to "Android apps": Google requires SHA-1 on REST calls.
# Set to the same 40-char SHA-1 as in Google Cloud (with or without colons). EAS: set for the production profile.
# EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_CERT_SHA1=

# Lemon Squeezy checkout via reverse proxy (see supabase/proxy/api.pixapp.kz.nginx.conf.example).
# If unset, server-side callers use Supabase Edge Functions URL directly (fine for local dev).
# EXPO_PUBLIC_PIXAPP_API_URL=https://api.pixapp.kz

# Edge Function secrets (Supabase Dashboard → Edge Functions → Secrets, not in this file):
# SUPABASE_SERVICE_ROLE_KEY=
# EXPO_ACCESS_TOKEN= (Expo account token; optional, improves Expo Push API rate limits)
# TEST_PUSH_SECRET= (shared secret header for `send-test-push` smoke test)
