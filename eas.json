{
  "cli": {
    "version": ">= 18.1.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SUPABASE_IMAGE_TRANSFORM": "0"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SUPABASE_IMAGE_TRANSFORM": "0"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_SUPABASE_IMAGE_TRANSFORM": "0"
      },
      "autoIncrement": false,
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      },
      "ios": {
        "simulator": false,
        "credentialsSource": "remote"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
